{
  "name": "opencode",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "runArgs": ["--dns=8.8.8.8", "--dns=1.1.1.1"],
  "postCreateCommand": "curl -fsSL https://bun.sh/install | bash",
  "remoteEnv": { "PATH": "/home/node/.bun/bin:${containerEnv:PATH}" },
  "customizations": {
    "vscode": { "extensions": ["oven.bun-vscode", "dbaeumer.vscode-eslint"] }
  }
}